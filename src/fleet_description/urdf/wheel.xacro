<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Drive wheel: continuous joint about +Y, visual from meshes/<robot>/wheel.obj, sphere collision.
       x, y are in base_link; the axle is at base_link height (z = 0).
       Collision: a sphere of the tyre radius touches the floor in one point at the tread mid-plane,
       the centroid of a real tyre's contact patch. A cylinder gives two rim contacts with arbitrary
       load sharing in DART's ODE collider (measured yaw ratio 1.11-1.17 for round/box instead of 1.0,
       docs/notes/ground.md G2). Limitation: the sphere sticks out r - w/2 past each tyre sidewall. -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <geometry><mesh filename="package://fleet_description/meshes/${robot_name}/wheel.obj"/></geometry>
      </visual>
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${mp['wheel']['inertia']['ixx']}" iyy="${mp['wheel']['inertia']['iyy']}" izz="${mp['wheel']['inertia']['izz']}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <!-- Isotropic Coulomb friction (catalog tyre sim.mu). DART reads only mu, mu2, fdir1, slip1/2 and
         restitution (gz-physics 7.8 dartsim/src/SDFFeatures.cc); kp/kd/minDepth/maxVel are ODE-only. -->
    <gazebo reference="${name}_link">
      <mu1>${wheel_mu}</mu1>
      <mu2>${wheel_mu}</mu2>
    </gazebo>
  </xacro:macro>
</robot>
