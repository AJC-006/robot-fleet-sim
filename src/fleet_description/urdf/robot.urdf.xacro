<?xml version="1.0"?>
<!-- Data-driven robot description: everything numeric comes from config/robots.yaml.
       xacro urdf/robot.urdf.xacro robot:=round camera:=false controllers_file:=/path/controllers.yaml
     Frames: base_footprint -> base_link (z = wheel_radius, or standing_height for `kind: legged`)
             -> <wheel>_link, caster_*_link | <leg>_{coxa,femur,tibia}_link (legs.xacro),
             laser_frame, imu_link, camera_link -> camera_{depth,color}_frame -> *_optical_frame (catalog macros). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fleet_robot">
  <xacro:arg name="robot" default="round"/>
  <xacro:arg name="camera" default="false"/>
  <xacro:arg name="controllers_file" default=""/>

  <xacro:include filename="$(find fleet_description)/urdf/inertia.xacro"/>
  <xacro:include filename="$(find fleet_description)/urdf/wheel.xacro"/>
  <xacro:include filename="$(find fleet_description)/urdf/caster.xacro"/>
  <xacro:include filename="$(find fleet_components)/urdf/lidar.xacro"/>
  <xacro:include filename="$(find fleet_components)/urdf/imu.xacro"/>
  <xacro:include filename="$(find fleet_components)/urdf/depth_camera.xacro"/>
  <xacro:include filename="$(find fleet_description)/urdf/ros2_control.xacro"/>
  <xacro:include filename="$(find fleet_description)/urdf/legs.xacro"/>

  <!-- configuration -->
  <xacro:property name="robot_name" value="$(arg robot)"/>
  <xacro:property name="cfg_path" value="$(find fleet_description)/config/robots.yaml"/>
  <xacro:property name="all_cfg" value="${xacro.load_yaml(cfg_path)}"/>
  <xacro:property name="cfg" value="${all_cfg[robot_name]}"/>
  <xacro:property name="use_camera" value="${'$(arg camera)' in ('true', 'True', '1')}"/>
  <xacro:property name="ctrl_arg" value="$(arg controllers_file)"/>
  <xacro:property name="ctrl_file" value="${ctrl_arg if ctrl_arg != '' else '/tmp/fleet_controllers_placeholder.yaml'}"/>

  <xacro:property name="kind" value="${cfg.get('kind', 'wheeled')}"/>
  <xacro:property name="wheel_radius" value="${cfg.get('wheel_radius', 0.0)}"/>
  <xacro:property name="wheel_width" value="${cfg.get('wheel_width', 0.0)}"/>
  <xacro:property name="wheel_separation" value="${cfg.get('wheel_separation', 0.0)}"/>
  <!-- masses and inertias: generated by tools/mass_properties.py (catalog parts + structure shell) -->
  <xacro:property name="mp" value="${xacro.load_yaml('$(find fleet_description)/config/mass_properties.yaml')[robot_name]}"/>
  <xacro:property name="wheel_mass" value="${mp['wheel']['mass'] if 'wheel' in mp else 0.0}"/>
  <!-- tyre friction from the catalog (components/tyre/<name>.yaml, sim.mu); DART takes min(tyre, floor) -->
  <xacro:property name="wheel_mu"
                  value="${xacro.load_yaml('$(find fleet_components)/components/tyre/' + cfg['components']['tyre'] + '.yaml')['sim']['mu'] if kind != 'legged' else 0.0}"/>
  <xacro:property name="n_pairs" value="${len(cfg.get('wheel_x', []))}"/>
  <xacro:property name="n_casters" value="${len(cfg.get('casters', []))}"/>
  <xacro:property name="n_collisions" value="${len(cfg['body']['collisions'])}"/>
  <xacro:property name="n_legs" value="${len(cfg.get('legs', []))}"/>
  <!-- base_link height above base_footprint; sensors.xacro uses it for the heights in robots.yaml -->
  <xacro:property name="base_z" value="${float(cfg['standing_height']) if kind == 'legged' else wheel_radius}"/>
  <xacro:property name="caster_mass" value="${mp['caster']['mass'] if 'caster' in mp else 0.0}"/>
  <xacro:property name="base_mass" value="${mp['base_link']['mass']}"/>
  <xacro:property name="comp" value="${cfg['components']}"/>

  <!-- recursive "loops" (xacro has none) -->
  <xacro:macro name="collision_from" params="i">
    <xacro:if value="${i &lt; n_collisions}">
      <collision>
        <xacro:if value="${cfg['body']['collisions'][i]['shape'] == 'box'}">
          <origin xyz="${cfg['body']['collisions'][i]['xyz'][0]} ${cfg['body']['collisions'][i]['xyz'][1]} ${cfg['body']['collisions'][i]['xyz'][2]}" rpy="${' '.join(str(v) for v in cfg['body']['collisions'][i].get('rpy', [0, 0, 0]))}"/>
          <geometry><box size="${cfg['body']['collisions'][i]['size'][0]} ${cfg['body']['collisions'][i]['size'][1]} ${cfg['body']['collisions'][i]['size'][2]}"/></geometry>
        </xacro:if>
        <xacro:if value="${cfg['body']['collisions'][i]['shape'] == 'cylinder'}">
          <origin xyz="${cfg['body']['collisions'][i]['xyz'][0]} ${cfg['body']['collisions'][i]['xyz'][1]} ${cfg['body']['collisions'][i]['xyz'][2]}" rpy="${' '.join(str(v) for v in cfg['body']['collisions'][i].get('rpy', [0, 0, 0]))}"/>
          <geometry><cylinder radius="${cfg['body']['collisions'][i]['radius']}" length="${cfg['body']['collisions'][i]['length']}"/></geometry>
        </xacro:if>
        <xacro:if value="${cfg['body']['collisions'][i]['shape'] == 'sphere'}">
          <origin xyz="${cfg['body']['collisions'][i]['xyz'][0]} ${cfg['body']['collisions'][i]['xyz'][1]} ${cfg['body']['collisions'][i]['xyz'][2]}" rpy="0 0 0"/>
          <geometry><sphere radius="${cfg['body']['collisions'][i]['radius']}"/></geometry>
        </xacro:if>
      </collision>
      <xacro:collision_from i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="wheels_from" params="i">
    <xacro:if value="${i &lt; n_pairs}">
      <xacro:wheel name="${cfg['left_wheels'][i]}" x="${cfg['wheel_x'][i]}" y="${wheel_separation / 2}"/>
      <xacro:wheel name="${cfg['right_wheels'][i]}" x="${cfg['wheel_x'][i]}" y="${-wheel_separation / 2}"/>
      <xacro:wheels_from i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="casters_from" params="i">
    <xacro:if value="${i &lt; n_casters}">
      <xacro:caster name="${cfg['casters'][i]['name']}" x="${cfg['casters'][i]['x']}" y="${cfg['casters'][i]['y']}" radius="${cfg['casters'][i]['radius']}"/>
      <xacro:casters_from i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="joints_from" params="i">
    <xacro:if value="${i &lt; n_pairs}">
      <xacro:wheel_joint name="${cfg['left_wheels'][i]}"/>
      <xacro:wheel_joint name="${cfg['right_wheels'][i]}"/>
      <xacro:joints_from i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <!-- links -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://fleet_description/meshes/${robot_name}/base.obj"/></geometry>
    </visual>
    <xacro:collision_from i="0"/>
    <inertial>
      <origin xyz="${mp['base_link']['com'][0]} ${mp['base_link']['com'][1]} ${mp['base_link']['com'][2]}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="${mp['base_link']['inertia']['ixx']}" iyy="${mp['base_link']['inertia']['iyy']}" izz="${mp['base_link']['inertia']['izz']}"
               ixy="${mp['base_link']['inertia']['ixy']}" ixz="${mp['base_link']['inertia']['ixz']}" iyz="${mp['base_link']['inertia']['iyz']}"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <xacro:wheels_from i="0"/>
  <xacro:casters_from i="0"/>
  <xacro:legs_from i="0"/>

  <!-- sensors -->
  <!-- sensors: the component names come from robots.yaml `components`; positions are heights above
       the ground, so the joint z is (z - base_z) in base_link -->
  <xacro:lidar model="${comp['lidar']}" parent="base_link"
               xyz="${cfg['lidar']['x']} ${cfg['lidar']['y']} ${cfg['lidar']['z'] - base_z}"/>
  <xacro:imu model="${comp['imu']}" parent="base_link"
             xyz="${cfg['imu']['x']} ${cfg['imu']['y']} ${cfg['imu']['z'] - base_z}"/>
  <xacro:depth_camera model="${comp['camera']}" parent="base_link" sensors="${use_camera}"
                      xyz="${cfg['camera']['x']} ${cfg['camera']['y']} ${cfg['camera']['z'] - base_z}"
                      rpy="0 ${cfg['camera']['pitch']} 0"/>

  <!-- ros2_control -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:joints_from i="0"/>
    <xacro:leg_joints_from i="0"/>
  </ros2_control>
  <xacro:gz_ros2_control_plugin params_file="${ctrl_file}"/>
</robot>
