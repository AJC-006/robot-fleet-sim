<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_auv</name>
  <version>0.1.0</version>
  <description>knucker: 4-thruster hover AUV (gz-sim buoyancy, hydrodynamics, thrusters, DVL) with depth/pitch/heading/surge control, LOS mission node and a lake test in the keep world.</description>
  <maintainer email="65161979+AJC-006@users.noreply.github.com">Alan</maintainer>
  <license>Apache-2.0</license>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>marine_acoustic_msgs</exec_depend>
