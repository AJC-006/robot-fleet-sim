Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 5
      Color: 120; 60; 160
    - Class: rviz_default_plugins/RobotModel
      Name: knucker
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: trail
      Enabled: true
      Topic:
        Value: /knucker/trail
        Depth: 5
        Reliability Policy: Reliable
      Color: 200; 80; 255
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/MarkerArray
      Name: mission
      Enabled: true
      Topic:
        Value: /knucker/mission_markers
        Depth: 5
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Pitch: 0.7
      Yaw: 3.6
      Focal Point:
        X: 60
        Y: 0
        Z: -10
    Saved: ~
