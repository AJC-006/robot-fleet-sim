Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 60
      Cell Size: 1
      Color: 120; 60; 160
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Marker
      Name: wyvern
      Enabled: true
      Topic:
        Value: /wyvern/marker
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: odometry
      Enabled: true
      Topic:
        Value: /wyvern/odom
        Depth: 5
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Axes
    - Class: rviz_default_plugins/Path
      Name: flown path
      Enabled: true
      Topic:
        Value: /wyvern/path
        Depth: 5
        Reliability Policy: Reliable
      Color: 230; 60; 220
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/MarkerArray
      Name: mission
      Enabled: true
      Topic:
        Value: /wyvern/mission_markers
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Pitch: 0.6
      Yaw: 3.9
      Target Frame: base_link
    Saved: ~
