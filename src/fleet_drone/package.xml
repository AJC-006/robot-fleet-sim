<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_drone</name>
  <version>0.1.0</version>
  <description>wyvern: PX4 SITL quadcopter (x500 physics, dragon-styled visuals) for the fleet_worlds worlds, with a uXRCE-DDS link, odometry/TF bridge and an offboard waypoint mission node.</description>
  <maintainer email="65161979+AJC-006@users.noreply.github.com">Alan</maintainer>
  <license>Apache-2.0</license>
  <license>BSD-3-Clause</license>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>fleet_worlds</exec_depend>
  <exec_depend>fleet_aircraft</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
